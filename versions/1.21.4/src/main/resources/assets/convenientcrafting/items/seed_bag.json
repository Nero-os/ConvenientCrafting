{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:container",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:model",
      "model": "convenientcrafting:item/seed_bag_filled"
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "convenientcrafting:item/seed_bag"
    }
  }
}
